@echo off
setlocal
powershell -NoProfile -ExecutionPolicy Bypass -Command "Write-Host '==================================================='; Write-Host '  Thunder CDP (Port 9222) Launcher'; Write-Host '==================================================='; Write-Host ''; Write-Host '[*] Checking if Thunder is already running with CDP...'; $proc = Get-CimInstance Win32_Process -Filter \"Name='Thunder.exe'\" -ErrorAction SilentlyContinue | Select-Object -First 1; if ($proc) { if ($proc.CommandLine -match '9222') { Write-Host '[OK] Thunder is already running in CDP mode (Port 9222).'; exit 0 } else { Write-Host '[*] Thunder is running, but WITHOUT CDP enabled. Terminating to restart with CDP...'; Stop-Process -Name 'Thunder' -Force -ErrorAction SilentlyContinue; Stop-Process -Name 'ThunderApp' -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2 } }; Write-Host '[*] Resolving Thunder installation path...'; $thunderPath = 'C:\Program Files (x86)\Thunder Network\Thunder\Program\Thunder.exe'; if (-not (Test-Path $thunderPath)) { Write-Host '[ERROR] Thunder executable not found at default path.'; exit 1 }; Write-Host '[*] Thunder path resolved: ' $thunderPath; Write-Host '[*] Terminating existing Thunder processes...'; Stop-Process -Name 'Thunder' -Force -ErrorAction SilentlyContinue; Stop-Process -Name 'ThunderApp' -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2; Write-Host '[*] Starting Thunder with CDP enabled...'; Start-Process -FilePath $thunderPath -ArgumentList '--remote-debugging-port=9222'; Write-Host '[OK] Thunder is now running with CDP enabled.'; exit 0"
exit /b %errorlevel%

